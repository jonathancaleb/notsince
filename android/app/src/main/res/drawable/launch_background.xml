<?xml version="1.0" encoding="utf-8"?>
<!-- What the OS shows between tapping the icon and Flutter's first frame.
     Painted in the app's own colours so there is no white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ns_paper" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
